package main;

var globalArr [3]int;

func main() {
    globalArr[0] = 10;
    globalArr[1] = 20;
    globalArr[2] = 30;

    println(globalArr[0]);
    println(globalArr[1]);
    println(globalArr[2]);
    println(len(globalArr));

    var localArr [5]int;
    localArr[0] = 1;
    localArr[1] = 2;
    localArr[2] = 3;
    localArr[3] = 4;
    localArr[4] = 5;

    var n int = len(localArr);
    println(n);

    var suma int = 0;
    for i := 0; i < n; i++ {
        suma = suma + localArr[i];
    };
    println(suma);

    var j int = 0;
    for j < n {
        println(localArr[j]);
        j = j + 1;
    };
};
